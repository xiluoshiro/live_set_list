APP_ENV=production
APP_LOG_LEVEL=INFO
APP_LOG_FILE=/var/log/livesetlist/app.log
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=live_statistic
DB_USER=live_project_ro
DB_PASSWORD=replace_me_runtime_ro
DB_WRITE_USER=live_project_super_ro
DB_WRITE_PASSWORD=replace_me_runtime_super
DB_USER_RW_USER=live_project_user_rw
DB_USER_RW_PASSWORD=replace_me_runtime_user_rw
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000

AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=8
AUTH_DEFAULT_ADMIN_ENABLED=false
AUTH_DEFAULT_ADMIN_USERNAME=
AUTH_DEFAULT_ADMIN_PASSWORD=
AUTH_DEFAULT_ADMIN_DISPLAY_NAME=

# 资料整理期临时允许无 Setlist Live 人工选择默认 Band 旧版本；整理完成后改为 false。
ALLOW_HISTORICAL_DEFAULT_BAND_SELECTION=true

CORS_ALLOW_ORIGINS=
LIVESETLIST_BACKUP_ROOT=/var/backups/livesetlist

POSTGRES_CONTAINER_NAME=live-set-list-postgres
POSTGRES_VOLUME_NAME=live_set_list_postgres_data
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me_postgres_owner
APP_DB=live_statistic
APP_OWNER=live_project_owner
APP_OWNER_PASSWORD=replace_me_app_owner
FLYWAY_USER=live_project_flyway
FLYWAY_PASSWORD=replace_me_flyway
APP_RO_USER=live_project_ro
APP_RO_PASSWORD=replace_me_runtime_ro
APP_SUPER_USER=live_project_super_ro
APP_SUPER_PASSWORD=replace_me_runtime_super
APP_USER_RW_USER=live_project_user_rw
APP_USER_RW_PASSWORD=replace_me_runtime_user_rw
TEST_ADMIN_USER=live_project_test_admin
TEST_ADMIN_PASSWORD=replace_me_test_admin
