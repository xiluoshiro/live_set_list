[Unit]
Description=LiveSetList database automatic backup
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=livesetlist
Group=livesetlist
WorkingDirectory=/opt/livesetlist/current
EnvironmentFile=/etc/livesetlist/backend.env
EnvironmentFile=/etc/livesetlist/postgres.env
ExecStart=/opt/livesetlist/current/backend/.venv/bin/python scripts/recovery_db.py backup-app-auto
