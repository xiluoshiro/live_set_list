#!/usr/bin/env bash
set -euo pipefail

readonly RELEASE_ROOT=/opt/livesetlist/releases
readonly CURRENT_LINK=/opt/livesetlist/current
readonly BACKEND_SERVICE=livesetlist-backend.service
readonly BACKUP_SERVICE=livesetlist-backup.service
readonly BACKUP_TIMER=livesetlist-backup.timer
readonly RELEASE_MANAGER=/usr/local/sbin/livesetlist-release-manager
readonly ARCHIVE_ROOT=/var/lib/livesetlist/release-archives

die() {
  echo "livesetlist-deploy: $*" >&2
  exit 1
}

wait_for_backend() {
  for attempt in {1..20}; do
    if curl --fail --silent --max-time 2 http://127.0.0.1:8000/api/health/db >/dev/null; then
      return 0
    fi
    sleep 1
  done
  echo "livesetlist-deploy: backend health check failed after 20 attempts" >&2
  return 1
}

if [ "$#" -ne 2 ]; then
  die "usage: livesetlist-deploy YYYY-MM-DD-NNN SHA256"
fi

VERSION=$1
EXPECTED_SHA256=$2
[[ "$VERSION" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$ ]] || die "invalid version: $VERSION"
[[ "$EXPECTED_SHA256" =~ ^[A-Fa-f0-9]{64}$ ]] || die "invalid SHA-256"

readonly RELEASE_NAME="livesetlist-$VERSION"
readonly ARCHIVE="$ARCHIVE_ROOT/$RELEASE_NAME.tar.gz"
readonly RELEASE_DIR="$RELEASE_ROOT/$RELEASE_NAME"

[ -f "$ARCHIVE" ] || die "archive not found: $ARCHIVE"
[ ! -e "$RELEASE_DIR" ] && [ ! -L "$RELEASE_DIR" ] || die "release already exists: $RELEASE_DIR (inspect before retrying)"
[ ! -e "$CURRENT_LINK.next" ] && [ ! -L "$CURRENT_LINK.next" ] || die "pending current link already exists: $CURRENT_LINK.next"

actual_sha256="$(sha256sum "$ARCHIVE" | awk '{print $1}')"
[ "$actual_sha256" = "$EXPECTED_SHA256" ] || die "archive checksum mismatch"

archive_entries="$(tar -tzf "$ARCHIVE")"
while IFS= read -r entry; do
  [[ "$entry" == "$RELEASE_NAME/"* ]] || die "unexpected archive entry: $entry"
  [[ "$entry" != *".."* ]] || die "unsafe archive entry: $entry"
done <<< "$archive_entries"

if ! tar -tvzf "$ARCHIVE" | awk '$1 ~ /^[lh]/ { found = 1 } END { exit found }'; then
  die "archive contains links"
fi

[ -x "$RELEASE_MANAGER" ] || die "release manager is not installed: $RELEASE_MANAGER"
"$RELEASE_MANAGER" verify-deploy "$VERSION" "$EXPECTED_SHA256"

systemctl start "$BACKUP_SERVICE"

previous_release="$(readlink -e "$CURRENT_LINK" || true)"
if [ -x "$CURRENT_LINK/backend/.venv/bin/python" ]; then
  readonly PYTHON_BIN="$CURRENT_LINK/backend/.venv/bin/python"
else
  readonly PYTHON_BIN=python3
fi

staging_dir="$(mktemp -d "$RELEASE_ROOT/.deploy.XXXXXX")"
release_created=0
switched=0
next_created=0
step=extract
diagnostics_since="$(date --iso-8601=seconds)"

backend_diagnostics() {
  echo "livesetlist-deploy: backend diagnostics before rollback" >&2
  timeout 10s systemctl --no-pager --full status "$BACKEND_SERVICE" >&2 || true
  timeout 10s journalctl --no-pager -b -u "$BACKEND_SERVICE" \
    --since "$diagnostics_since" -n 100 -o short-iso >&2 || true
}

rollback() {
  [ -n "$previous_release" ] && [ -d "$previous_release" ] || return 1
  echo "livesetlist-deploy: rolling back to $previous_release" >&2
  ln -s "$previous_release" "$CURRENT_LINK.next" || return 1
  next_created=1
  mv -Tf "$CURRENT_LINK.next" "$CURRENT_LINK" || return 1
  next_created=0
  systemctl restart "$BACKEND_SERVICE" || return 1
  nginx -t && systemctl reload nginx || return 1
}

cleanup() {
  local status=$? safe_to_remove=1 active_release
  trap - EXIT
  if [ "$status" -ne 0 ]; then
    echo "livesetlist-deploy: failed at $step (exit $status)" >&2
    if [ "$switched" -eq 1 ]; then
      backend_diagnostics
      if ! rollback; then
        safe_to_remove=0
        echo "livesetlist-deploy: rollback incomplete; retaining $RELEASE_DIR" >&2
      fi
    fi
    if [ "$release_created" -eq 1 ] && [ "$safe_to_remove" -eq 1 ]; then
      # Fail closed if current cannot be resolved. Never remove an active release.
      if active_release="$(readlink -f "$CURRENT_LINK")" && [ "$active_release" != "$RELEASE_DIR" ]; then
        rm -rf -- "$RELEASE_DIR" || echo "livesetlist-deploy: cleanup failed: $RELEASE_DIR" >&2
      else
        echo "livesetlist-deploy: current unresolved or still active; retaining $RELEASE_DIR" >&2
      fi
    fi
  fi
  if [ "$next_created" -eq 1 ]; then
    rm -f -- "$CURRENT_LINK.next" || true
  fi
  rm -rf -- "$staging_dir" || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

tar -xzf "$ARCHIVE" -C "$staging_dir"
[ -d "$staging_dir/$RELEASE_NAME" ] || die "archive root directory missing"
# Claim the directory exclusively; never take ownership of a pre-existing release.
mkdir "$RELEASE_DIR"
release_created=1
mv -T "$staging_dir/$RELEASE_NAME" "$RELEASE_DIR"

step=create-venv
"$PYTHON_BIN" -m venv "$RELEASE_DIR/backend/.venv"
step=install-dependencies
"$RELEASE_DIR/backend/.venv/bin/pip" install --disable-pip-version-check --no-cache-dir -r "$RELEASE_DIR/backend/requirements.txt"
step=install-units
chown -R root:root "$RELEASE_DIR"
chmod -R u=rwX,go=rX "$RELEASE_DIR"

install -o root -g root -m 644 "$RELEASE_DIR/infra/production/livesetlist-backend.service" "/etc/systemd/system/$BACKEND_SERVICE"
install -o root -g root -m 644 "$RELEASE_DIR/infra/production/livesetlist-backup.service" "/etc/systemd/system/$BACKUP_SERVICE"
install -o root -g root -m 644 "$RELEASE_DIR/infra/production/livesetlist-backup.timer" "/etc/systemd/system/$BACKUP_TIMER"
systemctl daemon-reload
systemctl enable "$BACKUP_TIMER"

step=switch-current
ln -s "$RELEASE_DIR" "$CURRENT_LINK.next"
next_created=1
mv -Tf "$CURRENT_LINK.next" "$CURRENT_LINK"
next_created=0
switched=1
step=restart-backend
systemctl restart "$BACKEND_SERVICE"
step=reload-nginx
nginx -t
systemctl reload nginx
step=wait-for-backend
wait_for_backend
step=post-deploy-backup
systemctl start "$BACKUP_SERVICE"
step=mark-deployed
"$RELEASE_MANAGER" mark-deployed "$VERSION" "$EXPECTED_SHA256"
trap - EXIT INT TERM
rm -rf -- "$staging_dir"

echo "deployed $RELEASE_NAME"
